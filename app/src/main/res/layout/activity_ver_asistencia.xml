<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- HEADER PREMIUM -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="#1E3A8A"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Asistencia"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión inteligente de estudiantes"
            android:textColor="#DCE7FF"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- TABLA HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#D9E2FF">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="Teléfono"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Cédula"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="Correo"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Estado"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"/>

    </LinearLayout>

    <!-- MENSAJE VACIO -->

    <TextView
        android:id="@+id/txtSinDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay estudiantes registrados"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone"/>

    <!-- RECYCLER -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEstudiantes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

</LinearLayout>